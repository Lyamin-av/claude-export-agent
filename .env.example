# Скопируйте в .env и заполните. Файл .env не попадает в Git.
# Провайдер LLM: anthropic (Claude API) или openai (любой OpenAI-совместимый сервер, например Ollama)
PROVIDER=anthropic
MODEL=claude-sonnet-5-5

# --- PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- PROVIDER=openai (Ollama) ---
# PROVIDER=openai
# MODEL=qwen3.5:9b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama            # Ollama ключ не проверяет, но поле обязательно
# LLM_TIMEOUT_SEC=600              # локальная модель может отвечать долго
# TEMPERATURE=0                    # необязательно
# Окно контекста задаётся в самой Ollama: переменная Windows OLLAMA_CONTEXT_LENGTH

# Gmail: адрес и ПАРОЛЬ ПРИЛОЖЕНИЯ (не основной пароль), см. README
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Приватный репозиторий для архива и его локальная папка
REPO_URL=https://github.com/<user>/claude-export-archive.git
ARCHIVE_DIR=C:/Users/PC/claude-export-archive

# Временная папка для скачанных zip
WORK_DIR=work

# Папка загрузок браузера (если не стандартная, например в OneDrive)
# DOWNLOADS_DIR=C:/Users/PC/Downloads

# Цены модели за 1 млн токенов в $ (возьмите со страницы цен Anthropic).
# Без них агент покажет только количество токенов.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
